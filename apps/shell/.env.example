# Sentra Shell — environment contract.
#
# Copy to `.env.local` (gitignored) to override. Every value here is a
# PLACEHOLDER; no real credential belongs in this file or in the repository.

# Serve data from MSW fixtures instead of the network.
# Default when unset in `vite dev`; must be set explicitly for a demo build.
VITE_SENTRA_MOCKS=true

# Federation remotes are NOT configured here. The live list is
# apps/shell/public/remotes.json, a runtime manifest loaded via
# registerRemotes() — see ADR 0004 — so a remote can be added or repointed
# without rebuilding or redeploying the host.
