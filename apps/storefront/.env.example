# Sentra Storefront — environment contract.
#
# Copy to `.env.local` (gitignored) to override. Every value here is a
# PLACEHOLDER; no real credential belongs in this file or in the repository.

# Serve data from MSW fixtures instead of the network.
# Default when unset in `vite dev`; must be set explicitly for a demo build.
VITE_SENTRA_MOCKS=true

# --- Live Shopify wiring (optional) -----------------------------------------
#
# SECURITY: Vite inlines every VITE_-prefixed variable into the client bundle.
# That is acceptable for the Storefront API token below, which Shopify scopes as
# public and expects to be readable by browsers. It is NEVER acceptable for an
# Admin API token, a webhook secret, or any server-side credential — those must
# not carry a VITE_ prefix, because doing so publishes them to every visitor.
#
# The Storefront token is still treated as a credential here: it is not
# committed, not logged, and not defaulted to a working value.

VITE_SENTRA_SHOPIFY_DOMAIN=your-shop.myshopify.com
VITE_SENTRA_SHOPIFY_TOKEN=replace-with-your-public-storefront-api-token
