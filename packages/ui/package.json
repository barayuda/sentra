{
  "name": "@sentra/ui",
  "version": "0.0.0",
  "private": true,
  "sentra": {
    "role": "platform"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build",
    "test:interactions": "test-storybook --url http://127.0.0.1:6006"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "@sentra/i18n": "workspace:*",
    "@sentra/tokens": "workspace:*",
    "@tanstack/vue-virtual": "3.13.36",
    "@vueuse/core": "14.4.0",
    "@vueuse/integrations": "14.4.0",
    "focus-trap": "8.2.2"
  },
  "devDependencies": {
    "@sentra/config": "workspace:*",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/test-runner": "0.24.4",
    "@storybook/vue3-vite": "10.5.10",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/vue": "8.1.0",
    "@types/react": "19.2.18",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "2.4.11",
    "happy-dom": "20.11.8",
    "http-server": "14.1.1",
    "playwright": "1.62.1",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "vue": "3.5.42",
    "vue-tsc": "3.3.11",
    "wait-on": "9.1.0"
  }
}
