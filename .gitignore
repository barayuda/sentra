# dependencies
node_modules/
.pnpm-store/

# build output
dist/
build/
storybook-static/
*.tsbuildinfo

# task runner caches
.turbo/
.cache/
.vite/

# @module-federation/vite build diagnostics, regenerated per build
.mf/

# environment — never commit real credentials
.env
.env.*
!.env.example

# test & audit output
coverage/
.lighthouseci/
playwright-report/
test-results/
blob-report/
# page snapshots written by the Playwright MCP server during debugging
.playwright-mcp/

# editor / OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# rtk local cache
.rtk/

# generated token stylesheet — regenerate with `pnpm --filter @sentra/tokens build`
packages/tokens/dist/

# throwaway federation spike — see docs/adr/0001
spike/**/node_modules/
spike/**/dist/

# planning docs — local only, never committed
docs/superpowers/

# agent execution scratch (ledgers, task briefs, review packages) — local only
.superpowers/

# isolated milestone worktrees — local only, removed once the branch merges
.worktrees/
