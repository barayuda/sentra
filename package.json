{
  "name": "sentra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.34.5"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "test:scripts": "vitest run",
    "verify:roles": "node scripts/workspace.mjs --check",
    "lint": "turbo run lint && eslint eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:sourcemaps": "node scripts/check-sourcemaps.mjs",
    "verify:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:audit": "node scripts/check-audit.mjs",
    "verify:csp": "node scripts/generate-csp.mjs"
  },
  "devDependencies": {
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  },
  "sentra": {
    "referenceDocs": [
      "docs/prd-feasibility"
    ]
  }
}
