{
  "name": "sentra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24.15.0",
    "pnpm": ">=10.34.5"
  },
  "pnpm": {
    "$comment": "GHSA-ph9p-34f9-6g65 (high) and GHSA-52f5-9888-hmc6 (low) both land on `tmp`, reached only through @lhci/cli — once directly, once via inquirer > external-editor. Neither has a direct dependent we control, so `overrides` is the only lever; 0.2.6 is the first release patched for both. Keys under `overrides` are package selectors fed to the resolver, so the rationale lives here rather than inside it. Named risk area: supply chain.",
    "overrides": {
      "tmp": "^0.2.6"
    }
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && vitest run",
    "test:scripts": "vitest run",
    "verify:roles": "node scripts/workspace.mjs --check",
    "lint": "turbo run lint && eslint eslint.config.js",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:sourcemaps": "node scripts/check-sourcemaps.mjs",
    "verify:bundle-size": "node scripts/check-bundle-size.mjs",
    "verify:audit": "node scripts/check-audit.mjs",
    "verify:csp": "node scripts/generate-csp.mjs",
    "verify:lighthouse": "lhci autorun --config=lighthouserc.json && node scripts/check-lighthouse-dom-floor.mjs lighthouserc.json",
    "verify:lighthouse:reference": "lhci autorun --config=lighthouserc.reference.json && node scripts/check-lighthouse-dom-floor.mjs lighthouserc.reference.json"
  },
  "devDependencies": {
    "@lhci/cli": "0.15.1",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-storybook": "10.5.10",
    "eslint-plugin-vue": "10.10.0",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "turbo": "2.10.12",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "vue-eslint-parser": "10.4.1"
  },
  "sentra": {
    "referenceDocs": [
      "docs/prd-feasibility"
    ],
    "referenceConfigs": [
      "lighthouserc.reference.json"
    ]
  }
}
